 b2d.world:=box2d.world(u0, gravity.x, gravity.y);
};

velocity.iteractions 8;
position.iteractions 3;

box2d.step(u0, b2d.world, 1/60, velocity.iteractions, position.iteractions);

# box2d main ]
# box2d new body [

if (r0) {
 # body0 - circle [

 ib0 { _ box2d.default.dynamic.body.info;
  x 100;
  y 200;
  damping.linear 0;
  gravity.scale 100;
 };
 b0 l0;
 b0:=box2d.body.create2(r0, b2d.world, ib0); 
 
 b0s0 l1;
 b0s0:=box2d.shape.create.circle(u0);
 box2d.shape.set.radius(u0, b0s0, 10);

 b0f0 l2;
 box2d.fixture.def(u0, 0.2, 0, 0, 0);
 b0f0:=box2d.fixture.create(u0, b0, b0s0);
 box2d.fixture.filter.collision(u0, b0f0, 1,2+1, 0);

 # body0 - circle ]
 # body1 - polygon [

 ib1 { _ box2d.default.static.body.info;
  x 100;
  y 100;
  angle 0;
 };
 b1 l3;
 b1:=box2d.body.create2(r0, b2d.world, ib1); 

 b1s1 l4;
 b1s1:=box2d.shape.create.polygon(u0);
 box2d.shape.polygon.box(u0, b1s1, 50, 15);

 b1f1 l5;
 box2d.fixture.def(u0, 0.2, 0, 0, 0);
 b1f1:=box2d.fixture.create(u0, b1, b1s1);
 box2d.fixture.filter.collision(u0, b1f1, 1,1+2, 0);

 # body1 - polygon ]

 dump {
  llog.b(S.box2d.new.body);
  llog.erase(u0, 0);
  llog.p(WARNING.box2d.reset.r0.is.needed); # ??? maybe?
  llog.p(LLOG.b.p.pv.e.test);
  llog.pv(S.b0, b0);
  llog.pv(S.b0s0, b0s0);
  llog.pv(S.b0f0, b0f0);
  llog.p(S.nice);
  llog.p(GG);
  llog.e();
 };
 dump;
};

# box2d new body ]
# box2d event [

