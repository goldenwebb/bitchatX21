 if (_0==1) {
  llog.pv(S.box2d.e.begin.contact, _0);
  llog.pv(S.box2d.ev.bodyA, o0);
  llog.pv(S.box2d.ev.fixtureA, o1);
  llog.pv(S.box2d.ev.bodyB, o2);
  llog.pv(S.box2d.ev.fixtureB, o3);
 };
 if (_0==2) {
  llog.pv(S.box2d.e.end.contact, _0);
 };
 if (_0==1) {
  bd0 r12;
  bd1 r11;
  bd0:=o0;
  bd1:=o2;
  box2d.body.get.position(u0, bd0);
  l0:=box2d.body.get.angle(u0, bd0);
  llog.pv2(S.box2d.bodyA.position, o0, o1);
  llog.pv(S.box2d.bodyA.angle, l0);

#  box2d.body.set.transform(u0, bd0, o0,o1+10, l0);
#  box2d.body.set.transform(u0, bd1, o0,o1+250, l0+1*pi);
  box2d.body.get.linear.velocity(u0, bd1);
  llog.pv2(S.box2d.bodyA.linear.velocity, o0, o1);
  box2d.body.set.linear.velocity(u0, bd1, o0,0+50+10*rnd(u0));
  l0:=box2d.body.get.angular.velocity(u0, bd1);
  llog.pv(S.box2d.bodyA.angular.velocity, l0);
#  box2d.body.set.angular.velocity(u0, bd1, l0-1);
  
  # tests api:5250 [

  events.push(u0, 5250,0, 1, 0,0,0,0);

  # tests api:5250 ]
 };
 llog.e();
};

_ @sys.events;
ev0 r14;
ev0:=events.pop(u0, box2d.e.pool, b2d.world);
while(ev0) { 
