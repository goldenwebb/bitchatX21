### ul.ui.collection.util

# buffer.std [

  buffer.resize {
   # u0, dma, id,i, size, default.value
   en0 _0;
   dma0 _1;
   size _4;
   default.value _5;

   buffer.dma(en0, dma0, _2,_3);
   csize dma.size(en0, dma0);
   if (csize > size) {
    dma.strip.size(en0, _1, size);
   };
   if (csize < size) {
    dma.fill(en0, dma0, csize, size-csize, default.value);
   };
  };

  buffer.set.count {
   # u0, dma, id, count, row.size,row.size.max, default.value
   en0 _0;
   dma0 _1;
   id _2;
   count _3;
   row.size _4;
   row.size.max _5;
   default.value _6;

   m buffer.count(u0, id);
   while (count>m) {
    buffer.add(en0, id, row.size,row.size.max);
    buffer.dma(u0, dma0, id,m);
    dma.fill(u0, dma0, 0, row.size, default.value);
   };
   if (count<m) {
#    buffer.remove(u0, items, count, m);
    buffer.remove(u0, items, m-1);
   };
  };

# buffer.std ]

### ul.ui.collection.mat2d

ui.collection.options.obj {
 _;
 _ @ul.ui.collection.util;
 
 resize.mat2d {
  # width,height
  # common: dma0, d0-d4

  width _0; height _1;
  i d0; j d1;
  n d2; m d3;
  items d4;

  n:=cols.g;
  m:=rows.g;

  items:=cells.g;

  if (width!=n) {
   # buffer.resize.all(en0, dma0, items, width, default.value);
   j:=0; while(j<m) {
    buffer.resize(u0, dma0, items,j, width, 0);
    j+=1;
   };
   cols.s(width);
  };

  if (height!=m) {
   buffer.set.count(u0, dma0, items, height, width,1000000, 0);
   rows.s(width);
  };

  dma.off(u0, dma0);
 };

 set.cell.mat2d {
  # i,j, cell::ui.collection.cell.obj
 };
};



