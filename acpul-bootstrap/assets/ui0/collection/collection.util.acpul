### ul.ui.collection.dump

ui.collection.options.obj.isavar 0;
ui.collection.options.obj {
 _;

 dump.ll {
  info ui.collection.default.options.info;

  llog.printv(u0, S.ui.collection.options.obj, isavar);

  llog.printv(u0, S.ui.cl0.type, type.g);
  llog.printv(u0, S.ui.cl0.width, width.g);
  llog.printv(u0, S.ui.cl0.height, height.g);
  llog.printv(u0, S.ui.cl0.cols, cols.g);
  llog.printv(u0, S.ui.cl0.rows, rows.g);
  llog.printv(u0, S.ui.cl0.scroll.direction, scroll.direction.g);
  llog.printv(u0, S.ui.cl0.cell.view.fid, cell.view.fid.g);
  llog.printv(u0, S.ui.cl0.cells.updated, cells.updated.g);
  llog.printv(u0, S.ui.cl0.node.scroll, node.scroll.g);
  llog.printv(u0, S.ui.cl0.grid.width, grid.width.g);
  llog.printv(u0, S.ui.cl0.grid.height, grid.height.g);

  llog.printo(u0, S.ui.cl0.obj, 0, isavar,-1);
  llog.printo(u0, S.ui.cl0.cells, 0, cells.g,-1);

  dump.cells.vec1d {
   i d0;
   cell0 d1;
   i:=0; while(i<buffer.size(u0, cells.g,0)) {
    cell0:=buffer.get(u0, cells.g,0, i);
    llog.printv(u0, S.ui.cl0.cellI.index, i);
    llog.printo(u0, S.ui.cl0.cellI, 0, cell0,-1);
    i+=1;
   };
  };

  dump.cells.mat2d {
   llog.printv(u0, S.ui.dump.cells.mat2d.is.TODO, -1);
  };
  dump.cells.mat3d {
   llog.printv(u0, S.ui.dump.cells.mat3d.is.TODO, -1);
  };

#  type.s(info.t.mat3d);

  if (type.g==info.t.vec1d) {
   dump.cells.vec1d;
  };
  if (type.g==info.t.mat2d) {
   dump.cells.mat2d;
  };
  if (type.g==info.t.mat3d) {
   dump.cells.mat3d;
  };
 };
};
