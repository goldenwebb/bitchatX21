### sys.cpu1

_ @sys.cpu;

cpu.get.formula.name1 {
 # fname, fid
 fname0 _0;
 fid0 _1;
 if (fname0==0) {
  fname0:=buffer.new(u0, 100,10000);
 };
 fname0:=cpu.get.formula.name(u0, 0, fid0, fname0);
};
