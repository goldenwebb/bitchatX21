### 11110000 tmp.text

mode0 r3;

_ @0;

text {
 _ @1010;
 _ @sys.media;
 _ @sys.obj;
 _ @sys.node;

 options.info {
  file {
   pool 1000;
   id 0;
   i 0;
  };
  font.size 100;
  vsh 10018020;
  fsh 10018021;
# vsh 15870;
# fsh 15871;
  texattr0 0;
  texunit0 0;
 };

# lvec0 r2;


 init {
  # r0, options, string
  r0 _0;
  string _2;

  font0 _1.font0;
  fchars0 _1.fchars0;

  fnt.load {
   # file
   font0:=media.ft.load.font(u0, 0, _0.pool,_0.id,_0.i);
  };
  if (r0) {
   fnt.load(_1.file);

   fchars0:=buffer.new(u0, 100*3*4, 100000*3*4); # x,y,z [+ shape] ;
   buffer.add(u0, fchars0, 100*4, 100000*4); # char, texture, offs0,offs1
   buffer.dma(u0, dma0, fchars0,0);
   buffer.dma(u0, dma1, fchars0,1);

   media.ft.text.dma(u0, font0,_1.font.size*2, string, dma0,dma1,-1);

   _ @sys.ul.ui;
   _ @ui.textlines;

   ui.textlines.lines.vec.scale.scale.line(0.5,0.5);
#lines.vec ui.textlines.lines.vec;
#   ui.textlines.lines.vec.scale(lvec0, 1, lines0, 0, 0.5,0.5);

#   _ @1010; _ @sys.llog; llog.b(A.tmp.text); 
#   llog.erase(u0, 0);
#   llog.pv(Q.font0, font0); 
#   llog.pv(Q.fchars0, fchars0); 
#   llog.pv(Q.text.dma0.size, dma.size(u0, dma0)); 
#   llog.pv(Q.text.dma1.size, dma.size(u0, dma1)); 
#   llog.e();

   dma.off(u0, dma0);
   dma.off(u0, dma1);
  };
 };

 # UPDATE

 update {
  # r0, options, string

  font0 _1.font0;
  fchars0 _1.fchars0;

  buffer.dma(u0, dma0, fchars0,0);
  buffer.dma(u0, dma1, fchars0,1);

  media.ft.text.dma(u0, font0,_1.font.size, _2, dma0,dma1,-1);

  dma.off(u0, dma0);
  dma.off(u0, dma1);
 };

 # DRAW

 draw {
  # r0, options, view
  r0 _0;

  font0 _1.font0;
  fchars0 _1.fchars0;
  vsh _1.vsh;
  fsh _1.fsh;
  texattr0 _1.texattr0;
  texunit0 _1.texunit0;

  node.ex.shader.use(u0, vsh,fsh);

  buffer.dma(u0, dma0, fchars0,0);
  buffer.dma(u0, dma1, fchars0,1);

  offscount 1;
  nchars=dma.get(u0, 1, offscount);

  startitems 8;
  itemsize 4;
  offstexture 1;

  tex0=dma.get(u0, 1, startitems+offstexture);

  node.ex.shader.uniform.texture.name(u0, texattr0, tex0, texunit0);

#  view _2;# {x 0;y 0;w 1;h 1;};
#  shader.uniform.f4(u0, 3, view.x,view.y,view.w,view.h);
  shader.uniform.f4(u0, 3, _2.x,_2.y,_2.w,_2.h);
#  shader.uniform.f4(u0, 3, 0,0,1,1);


  if (r0) {
#   _ @1010; _ @sys.llog; llog.b(Q.tmp.text); llog.pv(Q.texture, l0); llog.e();
#   _ @1010; _ @sys.llog; llog.b(Q.tmp.text); llog.pv(Q.count, l1); llog.e();
  };

  render.chars {
   i=0;
   while (i < nchars) {
   # r0, i, dma,o,esize,stride,count, type,normalized
    a0 0; # verts
    a1 1; # texCoords
#   dma0 0;
    eoffs 4*4*i;
    node.ex.shader.attribute.dma(u0, a1, dma0,eoffs,  2,4,4, 0,0);
    node.ex.shader.attribute.dma(u0, a0, dma0,eoffs+2,2,4,4, 0,0);

    node.ex.gl.draw(u0, 6, 4);
    i+=1;
   };
  };

  if (mode0 == 0) {
   render.chars;
  };
  if (mode0 == 1) {
#   render.chars;
   x 0;
   y 0;
   line 0;
   start.x 0;
   end.x w;
   render.chars1(x,y, line, nchars, start.x, end.x);
  };

# vsh 15870;
# fsh 15871;

  uniform1 1;
  uniform2 2;

  shader node.ex.shader;

  render.draw.char {

   a0 0; # verts
   a1 1; # texCoords
   eoffs 4*4*l2;
   # r0, i, dma,o,esize,stride,count, type,normalized
   shader.attribute.dma(u0, a1, dma0,eoffs,  2,4,4, 0,0);
   shader.attribute.dma(u0, a0, dma0,eoffs+2,2,4,4, 0,0);

#   shader.uniform.f2(u0, uniform1, x,y+sin((l2+t*0.05)*20)*100); 
   shader.uniform.f2(u0, uniform1, x,y); 

#   color.phase
#    shader.uniform.f1(u0, uniform2, _0);
   
#   color.phase(0+sin(t));
#   color.phase(0);
#   col l2;
#   l3:=cpu.get.formula.info.text.matrix.attribute(u0, fid0, line,col, 0);
#   shader.uniform.f1(u0, uniform2, l3);
   shader.uniform.f1(u0, uniform2, 0);

   node.ex.gl.draw(u0, 6, 4);
  };

 render.chars1 {
 # x,y, line, count, start.x, end.x
  x _0;
  y _1;
  line _2;
  count _3;
  start.x _4;
  end.x _5;

  l2:=0;
  while (l2 < count) {

   offs l2*8+8;
   cx0 = dma.get(u0, dma1, offs+4);
   cx1 = dma.get(u0, dma1, offs+4+2);

   if ((start.x<=cx0)*(cx1<=end.x)) {
    render.draw.char;
   };
   if (cx0>end.x) {
    l2:=count;
   };
   l2+=1;
  };

  dma.off(u0, dma0);
  dma.off(u0, dma1);
 };
};

