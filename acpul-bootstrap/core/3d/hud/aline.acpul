### 76000 aline

aline {
 _ @sys.obj;
 _ @util.dma.std;

 dma0 0; dma1 1; dma2 2; dma3 3; dma4 4;

 it {
  mode 0; # draw/move
  loc 1; # c tl tc tr r br bc bl
  x { 2;
   len 2; # percent
   start 3; # start
   end 4; # end
  };
  y { 5;
   len 5; # percent
   start 6; # start
   end 7; # end
  };
  r 8; # rotate
  max 9;
 };

 mode {
  draw 0;
  move 1;
 };

 loc {
  relative 0;
  c 1;
  tl 2; t 3; tr 4;
  r 5;
  br 6; b 7; bl 8;
  l 9;
 };

 align {

 };

 new {
  d0:=buffer.new(u0, 100*it.max,100000*it.max);
  buffer.dma(u0, dma0, d0,0);
  d0;
 };

 end {
  dma.off(u0,dma0);
 };
# put {
#  # v
#  dma.set(u0, dma0,dma.size(u0, dma0), _0);
# };
 add {
  # loc,mode,x:percent,len,start,y:percent,len,start,rotate
  dma.set8(u0, dma0,dma.size(u0, dma0), __);
  dma.set(u0, dma0,dma.size(u0, dma0), _8);
 };

 move
  # loc, x:percent(len),px(start,end),y:percent(len),px(start,end),rotate
  add(mode.move,__);

 draw0
  # loc, x:percent(len),px(start,end),y:percent(len),px(start,end),rotate
  add(mode.draw,__);

 draw
  # x:percent(len),px(start,end),y:percent(len),px(start,end),rotate
  draw0(loc.relative, __);

 build.curve3d {
  # path, line, w,h, grid.step.px, dw0,dw1
  path0 _0; line0 _1; w _2; h _3; step _4;
  dw0 _5; dw1 _6;

  vg.curve3d.use(path0);
  buffer.dma(u0, dma4, line0,0);

#  d1:=buffer.new(u0, 100,100000);
#  buffer.dma(u0, dma4, d1,0);

  x d2; y d3;
  x0 d4; y0 d5;
  x1 d6; y1 d7;

  w0 d8; h0 d9;
  step0 d10;

  dx d11; dy d12;

  m d14;
  q d15;

  q:=0;

  step0:=step;
  w0:=w/step0;
  h0:=h/step0;

  llog.pv {};
  llog.pv2 {};
  llog.pv3 {};

  llog.pv3(aline.w.h.step, w,h,step0);
  llog.pv2(aline.w0.h0, w0,h0);

#  vg.curve3d.add(0,-1,0, 111.1,-0.1, 0, 0,0,0);

  n:=dma.size(u0, dma4)/it.max;
  i:=0;while(i<n) {
   dma.get8(u0, dma4,i*it.max);
   mode0 o0;
   loc0 o1;
   xl o2; xs o3; xe o4;
   yl o5; ys o6; ye o7;


#   r o8;
   llog.pv(S.aline.i, i);
   llog.pv(S.mode, mode0);
   llog.pv(S.loc, loc0);
   llog.pv3(S.x, xl, xs, xe);
   llog.pv3(S.y, yl, ys, ye);
   llog.pv(S.r, r);

   calc.relloc {
    if (loc0==loc.c) { x:=w/2; y:=h/2; };
    if (loc0==loc.t) { x:=w/2; y:=h; };
    if (loc0==loc.tl) { x:=0; y:=h; };
    if (loc0==loc.tr) { x:=w; y:=h; };
    if (loc0==loc.b) { x:=w/2; y:=0; };
    if (loc0==loc.bl) { x:=0; y:=0; };
    if (loc0==loc.br) { x:=w; y:=0; };
    if (loc0==loc.r) { x:=w; y:=h/2; };
    if (loc0==loc.l) { x:=0; y:=h/2; };
#    llog.pv2(S.loc.xy, x,y);
   };

   calc.target.xy {
    x1:=x+(w*xl/100+xs-xe);
    y1:=y+(h*yl/100+ys-ye);
#    llog.pv3(S.target.x, xl, xs, xe);
#    llog.pv3(S.target.y, yl, ys, ye);
    llog.pv2(S.target.x1.y1, x1,y1);
   };

   move {
    calc.relloc;
    # new line
    calc.target.xy;
    x:=x1;
    y:=y1;
    llog.pv2(S.move.xy, x,y);
   };

   draw {
    calc.target.xy;
    dx:=x1-x;
    dy:=y1-y;
    llog.pv2(S.draw.dxdy, dx,dy);
    m:=round(max(abs(dx/step0),abs(dy/step0)));
    dx/=m;
    dy/=m;
    llog.pv2(S.draw.dxdy, dx,dy);
    llog.pv(S.draw.m, m);
    j:=0;while(j<m) {
#     llog.pv2(S.draw.xy, x,y);
     # fix later: d0,d1, p0,p1,p2,p3
#     vg.curve3d.add(x,y,0, 10.1*if(mod(j,8),0,1),-10.1, j/m, 0,0,0);
#     vg.curve3d.add(x,y,0, 10.1*if(mod(j,8),1,0),-10.1*if(mod(j,2),1,0), j/m, 0,0,0);
#     vg.curve3d.add(x,y,0, 4.1+10*sin(q*10),-1.1, q, 0,0,0);
#     vg.curve3d.add(x,y,0, 4.1,-1.1, q, 0,0,0);
     vg.curve3d.add(x,y,0, dw0,dw1, q, 0,0,0);

     x+=dx;
     y+=dy;
     j+=1;
     q+=0.1;
    };

   };

   if(mode0==mode.draw, draw, move);

   i+=1;
  };
#  vg.curve3d.add(x,y,0, 111,111, 0, 0,0,0);
#  vg.curve3d.add(-1,0,0, 0.1,-0.1, 0, 0,0,0);

  dma.off(u0,dma0);
  dma.off(u0,dma1);
  dma.off(u0,dma4);
 };
};

