### 179030:S blur-box.fsh


#ifdef GL_ES
precision mediump float;
#endif

varying vec2 v_texCoord;

#define tex0 p0
#define blurSize p1
#define viewXY p2
#define viewWH p3
#define mul p4


uniform sampler2D tex0;

uniform vec2 blurSize;

uniform vec2 viewXY;
uniform vec2 viewWH;

uniform vec4 mul;

void main() {
   vec4 sum = vec4(0.0);
   vec2 p = v_texCoord * viewWH;

   p += viewXY;

   sum += texture2D(tex0, p - 4.0 * blurSize) * 0.05;
   sum += texture2D(tex0, p - 3.0 * blurSize) * 0.09;
   sum += texture2D(tex0, p - 2.0 * blurSize) * 0.12;
   sum += texture2D(tex0, p - 1.0 * blurSize) * 0.15;
   sum += texture2D(tex0, p                ) * 0.16;
   sum += texture2D(tex0, p + 1.0 * blurSize) * 0.15;
   sum += texture2D(tex0, p + 2.0 * blurSize) * 0.12;
   sum += texture2D(tex0, p + 3.0 * blurSize) * 0.09;
   sum += texture2D(tex0, p + 4.0 * blurSize) * 0.05;
 
   gl_FragColor = sum*mul;

//varying vec4 v_fragmentColor;
//#define substract p1
//uniform vec4 substract;
    //vec4(sum.rg, v_texCoord.x, sum.a);
    //texture2D(CC_Texture0, v_texCoord+vec2(0, ));sum;
    //(sum - substract) *vec4(100.0, 6.4,9.0, 50.0);//* v_fragmentColor;
}

