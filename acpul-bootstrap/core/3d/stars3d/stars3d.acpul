### 200100:S stars.vsh

#define a_position a0
#define a_color a1

attribute vec4 a_position;
attribute vec4 a_color;

varying vec2 pointCenter;
varying float pointSize;
varying vec4 color;

#define timer CC_Time[3]*0.5

void main()
{
    mat3 rotation = mat3(
        vec3( cos(timer),  sin(timer),  0.0),
        vec3(-sin(timer),  cos(timer),  0.0),
        vec3(        0.0,         0.0,  1.0)
    );

    mat4 m = CC_MVPMatrix;
//    m[3][0] = timer;
//    m[3][1] += 0.1*timer;
//    m[3][2] = timer;
//    m[3][3] += 2.;

//  gl_Position = CC_MVPMatrix * vec4(rotation * a_position.xyz, 1.);
//  gl_Position = CC_MVPMatrix * a_position;
  
  vec4 pos = a_position;

//  pos.x *= pos.z;
//  pos.y *= pos.z;

  gl_Position = m * pos;
//  gl_PointSize = (gl_Position.x+1.0)*10.0;//a_position.x * 1.0;
//  gl_Position.z = a_position.z;
  pointSize = 500.*a_position.z;
//  gl_Position.x = 0.;//*= sin(10.*timer);
//  pointSize = -1000000.*gl_Position.z;
//  pointSize = 100.;
  gl_PointSize = pointSize;
  color = a_color;

  float SCALE_FACTOR = 2.;
  pointCenter = SCALE_FACTOR*(CC_MVMatrix * pos).xy;//vec2(250, 450);//gl_Position.xy;
}

### 200101:S stars.fsh

precision highp float;

varying vec2 pointCenter;
varying float pointSize;
varying vec4 color;

//varying vec2 v_texCoord;

//uniform sampler2D CC_Texture0;

void main() {
//  vec2 a = CC_Random01.xy*100.0+10000.0;
//  gl_FragColor = texture2D(CC_Texture0, v_texCoord)*vec4(0.5,0.3,1.0,0.5);
  vec2 offset = gl_FragCoord.xy - pointCenter;
  float r2 = dot(offset, offset);
  float sigma2 = 1.90*pointSize;
  float b = exp(-r2 / (2.0 * sigma2));
  float gSigma2 = 1.0*pointSize;
  b += 1.0 * exp(-r2 / (2.0 * gSigma2));
  b *= (max(0.0, 1.0-abs(offset.x+offset.y)) + max(0.0, 1.0-abs(offset.x-offset.y))) 
     * 3.0 + 0.5;
//  vec2 a = vec2(0.5)-offset/10.0;
//b=offset.x/100.;
//b=offset.x/768.;
//b=pointCenter.x/768.;
//b=gl_FragCoord.x/768.;
//b+=.5;
gl_FragColor = vec4(b, b, b, b)*color;
}

