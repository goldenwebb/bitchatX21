### 200100 stars3d.default

r0:=k==0;

draw(r0, 200101);

_ @1010;
_ @1100;
_ @sys.obj;
_ @sys.llog;

stars0 r7;
stars0.n r6;
stars0.n:=500;

#w 768;
w 1024;
h 1024;

new.stars {
 # stars, count
 stars0 _0;
 count _1;
 
 #elem.size=rtf0rgba
 #r - radius [min, max]
 #t - thetha [0, pi]
 #p - phi    [0, 2pi]

 elem.size 8;

 size count*elem.size;
 stars0:=buffer.new(u0, size,size);

 i:=0;
 while(i<count) {
  offset elem.size*i;
  l5:=i/count;

  buffer.set8(u0, stars0,0, offset, 
    rnd(u0)*w-w/2, rnd(u0)*h-h/2, rnd(u0), 1,
    rnd(u0),rnd(u0),rnd(u0),1
#    0.5+0.5*sin(i*pi*200), l5+0.5*sin(i*pi*112), round((l5*10)%2)*l5/5, 1
#    0.5+0.5*sin(i*pi*200), l5+0.5*sin(i*pi*112), round((l5*10)%2)*l5/5, 1
#    0.5+0.5*sin(i*pi*2000), 0.5+0.5*sin(i*pi*112), l5+0.5*sin(i*pi*12), 1
  );

  i+=1;
 };
};

move.stars {
 # stars, count
 stars0 _0;
 count _1;
 elem.size 8;

 i:=0; while(i<count) {
  offset elem.size*i;
  buffer.get4(u0, stars0,0,offset);
  z o2;
  o1-=dt*120*z;
#  o2:=sin(t*5)*0.1+0.5;

  o1:=if(o1>h/2, -h/2, o1);
  o1:=if(o1<-h/2, h/2, o1);

#  o1-=dt*120;
#  o1:=if(o1>h/2/z, -h/2/z, o1);
#  o1:=if(o1<-h/2/z, h/2/z, o1);
  buffer.set4(u0, stars0,0,offset, o0,o1,o2,o3);
  i+=1;
 };
};

t+=dt;

if (r0) {
 new.stars(stars0, stars0.n);

 llog.b(A.Stars3d);
 llog.erase(u0, 0);
 llog.printo(u0, S.stars0, 0, stars0,-1);
 llog.e();
};

x:=350;
y:=500;
s:=1.5;

k:=1;

move.stars(stars0, stars0.n);

