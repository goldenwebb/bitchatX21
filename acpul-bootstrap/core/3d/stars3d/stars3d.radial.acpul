### 201100:S stars.radial.vsh

#define a_position a0
#define a_color a1

attribute vec4 a_position;
attribute vec4 a_color;

varying vec2 pointCenter;
varying float pointSize;
varying vec4 color;

void main()
{
  vec4 pos;
  float r = a_position[0] * 100.0;
  float t = a_position[1]*0.2;
  float f = a_position[2];
  pos.x = r*sin(t)*cos(f);
  pos.y = r*sin(t)*sin(f);
  pos.z = r*cos(t);
  pos[3] = 1.0;
  vec4 pos1 = pos;
  float a = pos.z;
  float p = 200.0/(a+300.0);
  pos1.x = pos.x*p;//+512.0;
  pos1.y = -pos.y*p;//+384.0;
  pos=pos1;
  gl_Position = CC_MVPMatrix * pos;//a_position;
//  gl_PointSize = 0.0;
 gl_PointSize = 20000.0/pos.z;//(gl_Position.x+1.0)*10.0;//a_position.x * 1.0;
  if (gl_PointSize < 0.0)
    gl_PointSize = 0.0;
  else if (gl_PointSize > 50.0)
    gl_PointSize = 50.0;
//gl_PointSize = 140.0;
//gl_PointSize = pos.z/10000.0;
//  gl_Position.z = 0.0;//a_position.z;
  pointSize = gl_PointSize;
  color = a_color;

  float SCALE_FACTOR = 2.;
  pointCenter = SCALE_FACTOR*(CC_MVMatrix * pos).xy;//vec2(250, 450);//gl_Position.xy;
}



### 201101:S stars.radial.fsh

precision highp float;

varying vec2 pointCenter;
varying float pointSize;
varying vec4 color;

//varying vec2 v_texCoord;

//uniform sampler2D CC_Texture0;

void main() {
//  vec2 a = CC_Random01.xy*100.0+10000.0;
//  gl_FragColor = texture2D(CC_Texture0, v_texCoord)*vec4(0.5,0.3,1.0,0.5);
  vec2 offset = gl_FragCoord.xy - pointCenter;
  float r2 = dot(offset, offset);
  float sigma2 = 1.90*pointSize;
  float b = exp(-r2 / (2.0 * sigma2));
  float gSigma2 = 1.0*pointSize;
  b += 1.0 * exp(-r2 / (2.0 * gSigma2));
  b *= (max(0.0, 1.0-abs(offset.x+offset.y)) + max(0.0, 1.0-abs(offset.x-offset.y))) 
     * 3.0 + 0.5;
//  vec2 a = vec2(0.5)-offset/10.0;
//b=offset.x/100.;
//b=offset.x/768.;
//b=pointCenter.x/768.;
//b=gl_FragCoord.x/768.;
//b+=.5;
gl_FragColor = vec4(b, b, b, b)*color;
}

