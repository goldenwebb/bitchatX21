stars0 r7;

new.stars {
 # stars, count
 stars0 _0;
 count _1;
 
 #elem.size=rtf0rgba
 #r - radius [min, max]
 #t - thetha [0, pi]
 #p - phi    [0, 2pi]

 elem.size 8;

 size count*elem.size;
 stars0:=buffer.new(u0, size,size);

 i:=0;
 while(i<count) {
  offset elem.size*i;
  l5:=i/count;

  buffer.set8(u0, stars0,0, offset, 
    1.0+sin(i*pi/15)*5,
    pi*l5*10.1+0*10*2, 
    2*pi*l5+0*round((l5*10))/10, 
    0,
#    rnd(u0),rnd(u0),rnd(u0),1
#    0.5+0.5*sin(i*pi*200), l5+0.5*sin(i*pi*112), round((l5*10)%2)*l5/5, 1
#    0.5+0.5*sin(i*pi*200), l5+0.5*sin(i*pi*112), round((l5*10)%2)*l5/5, 1
    0.5+0.5*sin(i*pi*2000), 0.5+0.5*sin(i*pi*112), l5+0.5*sin(i*pi*12), 1
  );

  i+=1;
 };
};

move.stars {
 # stars, count
 stars0 _0;
 count _1;

 elem.size 8;

 l12:=l12+dt*0.1;
 i:=0;
 while(i<count) {
  offset elem.size*i;

  buffer.get4(u0, stars0,0, offset);

  l0:=o0;
  l1:=o1;
  l2:=o2;
  l3:=o3;

  o0:=l0*cos(l1);
  o1:=l0*sin(l1)*cos(l2);
  o2:=l0*sin(l1)*sin(l2);
  #rotate (x, z, alpha);
  #x'=p5, z'=p6;
  o3:=0;#pi/30;
#  o3:=pi/300;

  p5:=o1*cos(o3)-o0*sin(o3);
  p6:=o1*sin(o3)+o0*cos(o3);
  #transform (x,z)(r)-&gt;(t, f);
  o1:=p5;
  o0:=p6;
#  l1:=atan(sqrt(o1*o1+o2*o2)/o0);

  l1+=10*dt;
#  l2+=10*dt;
#  l0+=sin(dt*10)*5;
#  l0+=0.1;


#  l2:=if(o1>0,if(o2>=0, atan(o2/o1), 0), 0);
#  l2:=if(o1<=0, pi+atan(o2/o1), l2);
#  l2:=if(o1>=0,if(o2<0, 2*pi+atan(o2/o1), l2), 0);

#  l1:=l1+0.01*rnd(r0)-0.005;#*sin(l12*32*pi);

  buffer.set4(u0, stars0,0, offset, l0,l1,l2,l3);
#  p2:=sin(p4/100);
#  p4:=p4+1*l12;
#  p3:=p3+1;
#watch(l0);
  i+=1;
 };
};

