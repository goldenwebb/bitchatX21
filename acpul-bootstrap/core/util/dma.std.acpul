### I.buffer.from.dma
# Example:
# buffer.from.dma(buf0, dma0, dma1,i);

buffer.from.dma {
 # buf, dma0, dma1,b0
 buf _0; dma0 _1; dma1 _2; n _3;
 n=dma.size(u0, dma0);
 buf:=buffer.new(u0, n, n);
 buffer.dma(u0, dma1, buf,0);
 dma.copy(u0, dma1,0, dma0,0, n);
};

buffer.from.dma0 {
 buf0 0;
 buffer.from.dma(buf0, 0, 1, 1024)
 buf0;
}

### jobj.util

_ @I.buffer.from.dma;

# Example:
# v=jobj.parse(jobj0, Apple.Key,0);
# if (o0*v<0) {error;};
#

jobj.parse {
 # j0, name,i -> v, o0=err
 j0 _0; name _1; i _2;
 dma0 0; dma1 1;
 buf0 0;
l11;
 res=jobj.buf.dma(j0, name, dma0);
 buffer.from.dma(buf0, dma0, dma1,i);
 str.parse.value(0, buf0, 0,0); # parse %f
};
