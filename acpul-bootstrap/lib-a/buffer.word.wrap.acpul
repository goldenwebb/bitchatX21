### buffer.word.wrap


# BUFFER WORD WRAP BY WIDTH [

_ @buffer.up;

# LIB [

buffer.strip.size {
 # u0, buf,i, size
 u0 _0;
 buf0 _1;
 line0 _2;
 size _3;
 dma00 0;
 buffer.dma(u0, dma00, buf0,line0);
 dma.strip.size(u0, dma00, size);
 dma.off(u0, dma00);
};

# LIB ]

www 0;

buffer.word.wrap1 {
 # buf,i, width -> buf:lines
 buf0 _0;
 index0 _1;
 width0 _2;

 EOL 10;
 SPACE 32;
 
 lastpos=0;
 col=0;

 buf1=buffer.new(u0, 121,1000000);
 index1 0;

 append.line {
  buffer.add(u0, buf1, -1,-1);
  index1+=1;
 };

 # for each line - todo

 n=buffer.size(u0, buf0,index0);

 i=0;while(i<n) {
  char=buffer.get(u0, buf0,index0,i);

  buffer.set(u0, buf1,index1,col, char);

  col+=1;

  if (char==SPACE) {
   lastpos:=i;
  };

  if (col>width0) {

   # fix last position
   if (lastpos==0) {
    lastpos:=i;
   };

   # strip output size
   col1 = col + lastpos-i;
   buffer.strip.size(u0, buf1,index1, col1);

   append.line;

   # reset
   col:=0;

   i:=lastpos;

   lastpos:=0;
  };

  i+=1;
 };
 buf1;
# buf0;
};

buffer.word.wrap1x {
 # buf,i, width -> buf:lines
 buf0 _0;
 index0 _1;
 width0 _2;

 EOL 10;
 SPACE 32;
 
 lastpos=0;
 col=0;

 buf1=buffer.new(u0, 121,1000000);
 index1 0;

 append.line {
  buffer.add(u0, buf1, -1,-1);
  index1+=1;
 };

 # for each line - todo

 n=buffer.size(u0, buf0,index0);

 i=0;while(i<n) {
  char=buffer.get(u0, buf0,index0,i);

  buffer.set(u0, buf1,index1,col, char);

  col+=1;

  if (char==SPACE) {
   lastpos:=i;
  };

  if (col>width0) {
   # strip
   col1 = col + i-lastpos;
   buffer.strip.size(u0, buf1,index1, col1);

   append.line;

   # reset
   col:=0;
   i:=lastpos;
  };

  i+=1;
 };
 buf1;
};

