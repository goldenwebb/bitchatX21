SPACE 32;

dma.wrap.scan.back {
 # dma,i
 dma0 _0;
 i=_1;

 llog.pv(WRAP.I, i);

 res 0;
 while(i>=0) {
  res:=i;
  char=dma.get(u0, dma0,i);
  if (char==SPACE) {
   i:=0; # break
   res;
  };
  i-=1;
 };
 res;
};

