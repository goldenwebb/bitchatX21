   start0=dma.wrap.scan.back(dma0, i);
#www:=start0;

   llog.pv(START0, start0);
   
   j = i-start0;

   llog.pv(J, j);

   found = (j>0)*(j<col);
   if (found) {
    len=i-start0;

    
    llog.pv(LEN, len);

    buffer.dma(u0, dma1, buf1,index);
    dma.copy(u0, dma1,0, dma0,start0+1, len);
   llog.po(DMA1, 0+8, dma1,-1);
    col:=len;

    dma2 2;

