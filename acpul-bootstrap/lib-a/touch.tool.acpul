### touch.tool

# functions:
# click
# move
# scale on click
# volatile state


### touch.tool.default

# TOUCH [

#_ @sys.os;
_ @os.util2;

_ @sys.touch;
_ @sys.events;

pressed 0;
clicked 0;
moving 0;

x0 0; y0 0;
xs 0; ys 0; 
dx.max 5;
dy.max 5;


touch.id 0;
touch.b0 0;


touch.ev {
 began {
  # x,y, gx,gy

  x0:=_2;
  y0:=_3;
  xs:=x0;
  ys:=y0;

  pressed:=1;
  clicked:=1;
 };
 moved {
  # x,y, gx,gy

  xp = x0;
  yp = y0;

  # check clicked
  if ((abs(_3-ys)>dy.max)+(abs(_2-xs)>dx.max)) {
   clicked:=0;
   moving:=1;
  };
  if (moving) {
   x+=_2-x0;
   y+=_3-y0;
   x0:=_2;
   y0:=_3;
  };
 };
 ended {
  # x,y, gx,gy

  pressed:=0;
  moving:=0;

  click.ended;
 };
};
#  CREATURE0.SMILE 70802;
#  node.new.this.ex4(r0+(rnd(u0)<0.001), CREATURE0.SMILE, 1*rnd(u0),1*rnd(u0)+200, 0,0);

if (moving) {
 node.z.to.front(u0, nid,0);
};

#if (r0) {
#  s:=1/4;
#};


if (TOUCH_NO_ANCHOR!=0,
 touch.rect2.lock(touch.id, 0,0,w,h),
 touch.rect2.lock(touch.id, TOUCH_ANCHOR_X,TOUCH_ANCHOR_Y,w,h)
);


_ @sys.touch.ev.process.once;
touch.b0:=1;
touch.ev.process.multi;

### touch.tool.default.move0.store

_ @touch.tool.default;

_ @sys.obj.volatile;
_ @sys.llog;

#llog.b(touch.tool.default.move0.store);
#llog.erase(r0, 0);

num0 {x 0; y 0; s 0;};

l 0; l+=0.1;

if (r0==0) {
# llog.printv(l<2, L, l);
# llog.printv(l<2, TOUCH_POS_X, x);
# llog.printv(l<2, A.volatile.num.bid0, volatile.num.bid0);
 x:=volatile.num(u0, TOUCH_POS_X, num0.x, x);
# llog.printv(l<2, TOUCH_POS_X.res, x);
 y:=volatile.num(u0, TOUCH_POS_Y, num0.y, y);
# s:=volatile.num(u0, TOUCH_POS_S, num0.s, s);
};

if (r0) {
 node.z.to.front(u0, nid,0);
};

#llog.e;


### touch.tool.default.scale0

touch.click.ended {
 if (clicked) {
  s/=2;
  s:=if(s<=3/16/2,2,s);
  s:=if(s<=1/4/2,3,s);
 };
};

_ @touch.tool.default;

### touch.tool.default.scale0.store

_ @touch.tool.default.scale0;

_ @sys.obj.volatile;
_ @sys.llog;

llog.b(touch.tool.default.scale0.store);
#llog.erase(r0, 0);

num0 {x 0; y 0; s 0;};

l 0; l+=0.1;

if (r0==0) {
# llog.printv(l<2, L, l);
# llog.printv(l<2, TOUCH_POS_X, x);
# llog.printv(l<2, A.volatile.num.bid0, volatile.num.bid0);
 x:=volatile.num(u0, TOUCH_POS_X, num0.x, x);
# llog.printv(l<2, TOUCH_POS_X.res, x);
 y:=volatile.num(u0, TOUCH_POS_Y, num0.y, y);
 s:=volatile.num(u0, TOUCH_POS_S, num0.s, s);
};

if (r0) {
 node.z.to.front(u0, nid,0);
};

llog.e;

### touch.ex

touch1.rect3 {
 # x,y,w,h, handler
 touch.id 0;
 touch.b0 0;
 x _0; y _1; w _2; h _3;

 touch.rect2.lock(touch.id, x,y,w,h);

 touch.ev _4;

 _ @sys.touch.ev.process.once;
 touch.b0:=1;
 touch.ev.process.multi;
};
