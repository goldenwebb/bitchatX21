### basic.lines2d.test

_ @basic.lines2d;

lines2d.test0 {
  figure2 {
   # hid
   sn1lines _0;
   shader.set.uniformi.v2(sn1lines, A.lineXY, 0, -0.5,0);
   shader.set.uniformi.v2(sn1lines, A.lineXY, 1, 0.1,0.2);
   shader.set.uniformi.v2(sn1lines, A.lineXY, 2, 0.5,0.3);
   shader.set.uniformi.v2.count(sn1lines, A.lineXY, 3);
  };
};

lines2d.test0 { _;
 sn1lines 0;

 new.lines2d(sn1lines, 0,420,1, 300,300);

 lines2d.figure1(sn1lines);
# lines2d.test0.figure2(sn1lines);
 lines2d.figure1.color1(sn1lines);

 shader.set.uniform.v4(sn1lines, A.backgroundColorAdd, 0.0, -0.5, -0.9, 0);
};
