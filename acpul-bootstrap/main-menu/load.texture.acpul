### load.texture

load.texture {
 # tex, pool,id,i
 tex _0;

 # Import for use gl.texture.param
 _ @photoneo.common.gl.extra;

 tex:=storage.image.load.texture(_1,_2,_3);
# gl.texture.filter.nearest(tex);
};

load.texture.nearest {
 load.texture(__);
 gl.texture.filter.nearest(_0);
};

load.texture.linear {
 load.texture(__);
 gl.texture.filter.nearest(_0);
};

