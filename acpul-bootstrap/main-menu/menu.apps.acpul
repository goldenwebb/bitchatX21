### acpu.menu.apps

# RUNNINGS: RUN APP [

_ @map.future;

runnings {
 map0 0;
 
 # Init runnings
 init {
  map0:=map.new(u0, 100,10000);
 };

 # Run app - todo: toggle.app
 run.app {
  # fid
  fid _0;
  found=it.key(u0, map0,0, fid);
  if (found!=-1) {
   # FOUND
   app0=map.it.get.v(u0, map0,0);
   map.key.erase(u0, map0,0, fid);
   kill.app(app0);
  };
  if (found==-1) {
   # NOT FOUND
   app0=node.new.this.ex(u0, fid, 0);
   map.key.new.v(u0, map0,0, fid, app0);
  };
 };
 toggle.app {
  run.app(__);
 };
 kill.all {
  fn {
   # map0:it
   app0=map.it.get.v(u0, map0,0);
   kill.app(app0);
  };
  map.for.each(u0, map0,0, fn);

  # recreate map
  obj.delete(u0, map0);
  map0:=map.new(u0, 100,10000);
 };
};

if (r0) {
 runnings.init;
};

# RUNNINGS: RUN APP ]
# TOGGLE APP1 [

toggle.app1 {
 # id, run
 id0 _0;
 show {
  _1;
 };
 hide {
  kill.app(id0);
 };
 if(id0, hide, show);
};

# TOGGLE APP1 ]


# CLOSE APP

kill.app {
 # app
 node.prop.lt.s(u0, _0, 0.01);
 _0:=0;
};

close.apps {
 runnings.kill.all;
 kill.app(hn0);
 kill.app(dota0);
 kill.app(dota1);
 kill.app(chat0);
 kill.app(player0);
 kill.app(files0);
 kill.app(paint0);
 kill.app(wallet0);
 kill.app(hero0);
 kill.app(video0);
 kill.app(bootloader0);
 kill.app(intro0);
 kill.app(hipster0);
 kill.app(winamp0);
 kill.app(magazine0);
};

# APPS EVENTS

process.apps.events {
 # ev, o0... - event

 if (_0==boot.run.dota) {
  toggle.dota;
 };
 if (_0==boot.toggle.dota.test) {
  toggle.dota.test;
 };

 if (_0==boot.close.apps) {
  hide.default;
  close.apps;
 };
 if (_0==boot.toggle.files) {
  toggle.files;
 };
 if (_0==boot.toggle.player) {
  toggle.player;
 };
 if (_0==boot.toggle.magazine) {
  toggle.magazine;
 };
 if (_0==boot.toggle.ai.chat) {
  toggle.ai.chat;
 };
 if (_0==boot.toggle.stars) {
  toggle.stars;
 };
 if (_0==boot.event.intro) {
  new.startup.intro;
 };
 if (_0==boot.event.hipster) {
  toggle.hipster;
 };
 if (_0==boot.event.winamp) {
  toggle.winamp;
 };
 if (_0==boot.event.run.app) {
  fid=o0;
  runnings.toggle.app(fid);
 };
# if (_0==boot.toggle.hero) {
#  toggle.hero;
# };

};

# STARTUP APP [

startup.app {
 # flag, nfid
 if (r0*_0) {
  runnings.toggle.app(NNN(_1));
 };
};

startup.app(BOOT.RESUME, resume.bubbles.test);

# STARTUP APP ]
# DOTA [

dota0 0;

