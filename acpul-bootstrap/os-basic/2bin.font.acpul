    l(4,8, 0,0);
    cursor.next.sym(4,8);
   };
   X8 {
    l(0,0, 4,0); 
    l(0,0, 0,8);
    l(0,8, 4,8);
    l(4,0, 4,8);
    l(0,4, 4,4);
    cursor.next.sym(4,8);
   };
   X9 {
    l(0,0, 4,0); 
    l(0,4, 0,8);
    l(0,8, 4,8);
    l(4,0, 4,8);
    l(0,4, 4,4);
    cursor.next.sym(4,8);
   };
  };

  symbols { # task.new
   dot {};
   comma {};
   quote {};
   minus {};
   plus {};
   underscore {};
   brace.l {};
   brace.r {};
   space {};
  };
  symbols1 {
   DOT {
    l(0,0, 1,0);
