 # EXP SLOW COMPILE BAD [

 putv.xx {
  v _0;
  putv.x(mod(floor(v/10), 10));
  putv.x(mod(v,10));
 };

 putv.xxx {
  v _0;
  putv.x(mod(floor(v/100), 10));
  putv.xx(mod(v, 100));
 };

 putv1 {
  v _0;
#  putv.xx(l0);
  if (v<10){putv.x(floor(v));};
  if ((v>=10)*(v<100)){putv.xx(v);};
#  if (v>=100) {putv.xx(99);};
  if ((v>=100)*(v<1000)){putv.xxx(v);};
  if (v>=1000) {putv.xxx(999);};
 };

