 };
};



### 90102 2bin.font.test

r0:=k==0;

draw(r0, 90103);

y:=150;

k:=1;

### 90103 2bin.font.test.draw

_ @90100;

twobin.font.def8x4.scale 3;
twobin.font.def8x4.cursor.x l0;
twobin.font.def8x4.cursor.y l1;
twobin.font.def8x4.gap 10;

psize(u0, 3);
color(u0, 1,1,1,1);

