   };
   X4 {
    l(0,4, 0,8); 
    l(0,4, 4,4); 
    l(4,0, 4,8); 
    cursor.next.sym(4,8);
   };
   X5 {
    l(4,0, 4,4); 
    l(0,4, 0,8);
    l(0,0, 4,0);
    l(0,4, 4,4);
    l(0,8, 4,8);
    cursor.next.sym(4,8);
   };
   X6 {
    l(4,0, 4,4); 
