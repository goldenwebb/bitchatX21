### 90100 2bin.font.inc

twobin.font.test 90102;

# ABCDEFGHI j K l MNOP q RST u V w X y Z

twobin.font { _;
 # scale
 # gap
 # cursor.{x,y}
 def8x4 {
  s scale;
  cx cursor.x;
  cy cursor.y;
  l line(u0, 3, cx+_0*s,cy+_1*s, cx+_2*s,cy+_3*s);
#  l {psize(u0,1);triangle(u0, 6, cx+_0*s,cy+_1*s, cx+_2*s,cy+_3*s, cx+_2*s-5,cy+_3*s+5+sin(t*10)*10);};
#  l {psize(u0,1);triangle(u0, 6, cx+_0*s,cy+_1*s, cx+_2*s,cy+_3*s, cx+_2*s+5,cy+_3*s+1*s;};
  cursor.next.sym {
   # x,y
   x _0;
   cx+=x*s+gap;
  };
  begin {
   cx:=0;
  };
  upper {
    A {
     l(0,0, 0,8); 
     l(4,0, 4,8);
     l(0,8, 4,8); 
     l(0,4, 4,4);
     cursor.next.sym(4,8);
    };
    B {
     l(0,0, 0,8); 
     l(4,0, 4,4);
     l(0,4, 4,4); 
     l(0,0, 4,0);
     cursor.next.sym(4,8);
    };
    C {
     l(0,0, 0,8); 
     l(0,8, 4,8);
     l(0,0, 4,0);
     cursor.next.sym(4,8);
    };
    D {
     l(0,0, 0,4); 
     l(0,4, 4,4);
     l(4,0, 4,8); 
     l(0,0, 4,0);
     cursor.next.sym(4,8);
    };
    E {
     l(0,0, 0,8); l(0,0, 4,0);
     l(0,4, 4,4); l(0,8, 4,8);
     cursor.next.sym(4,8);
    };
    F {
     l(0,0, 0,8); 
     l(0,4, 4,4); l(0,8, 4,8);
     cursor.next.sym(4,8);
    };
    G {
     l(0,0, 0,8); 
     l(0,8, 4,8); 
     l(0,0, 4,0);
     l(4,0, 4,4);
     cursor.next.sym(4,8);
    };
    H {
     l(0,0, 0,8); 
     l(4,0, 4,8); 
     l(0,4, 4,4);
     cursor.next.sym(4,8);
    };
    I {
     l(2,0, 2,8); 
     cursor.next.sym(4,8);
    };
    J {
     l(0,0, 0,4); 
     l(0,0, 4,0); 
     l(4,0, 4,8); 
     cursor.next.sym(4,8);
    };
    K {
     l(0,0, 0,8); 
     l(0,4, 4,8); 
     l(0,4, 4,0); 
     cursor.next.sym(4,8);
    };
    L {
     l(0,0, 0,8); 
     l(0,0, 4,0); 
     cursor.next.sym(4,8);
    };
    M {
     l(0,0, 0,8); 
     l(4,0, 4,8);
     l(0,8, 2,4); 
     l(2,4, 4,8);
     cursor.next.sym(4,8);
    };
    N {
     l(0,0, 0,8); l(0,8, 4,0); l(4,0, 4,8);
     cursor.next.sym(4,8);
    };
    O {
     l(0,0, 0,8); l(4,0, 4,8);
     l(0,0, 4,0); l(0,8, 4,8);
     cursor.next.sym(4,8);
    };
    P {
     l(0,0, 0,8); l(4,4, 4,8);
     l(0,8, 4,8); l(0,4, 4,4);
     cursor.next.sym(4,8);
    };
    Q {
     l(0,0, 0,8); l(4,0, 4,8);
     l(0,0, 4,0); l(0,8, 4,8);
     l(2,2, 5,-1);
     cursor.next.sym(4,8);
    };
    R {
     l(0,0, 0,8); 
     l(0,8, 4,8);
     l(0,4, 4,4); 
     l(4,4, 4,8);
     l(0,4, 4,0);
     cursor.next.sym(4,8);
    };
    S1 {
     l(0,0, 4,1); 
          l(4,1, 4,3);
               l(4,3, 0,5);
                    l(0,5, 0,7);
                         l(0,7, 4,8);
     cursor.next.sym(4,8);
    };
    S {
     l(0,1, 0,0); 
     l(4,8, 4,7); 
     l(0,0, 4,0); 
          l(4,0, 4,4);
               l(4,4, 0,4);
                    l(0,4, 0,8);
                         l(0,8, 4,8);
     cursor.next.sym(4,8);
    };
    T {
     l(2,0, 2,8); 
     l(0,8, 4,8); 
     cursor.next.sym(4,8);
    };
    U {
     l(0,0, 0,8); 
     l(4,0, 4,8); 
     l(0,0, 4,0); 
     cursor.next.sym(4,8);
    };
    V {
     l(0,8, 2,0); 
     l(2,0, 4,8); 
     cursor.next.sym(4,8);
    };
    W {
     l(0,0, 0,8); 
     l(4,0, 4,8);
     l(0,0, 2,4); 
     l(2,4, 4,0);
     cursor.next.sym(4,8);
    };
    X {
     l(0,0, 4,8); 
     l(0,8, 4,0);
     cursor.next.sym(4,8);
    };
    Y {
     l(0,8, 2,4); 
     l(2,4, 4,8);
     l(2,4, 2,0); 
     cursor.next.sym(4,8);
    };
    Z {
     l(0,0, 4,8); 
     l(0,8, 4,8);
     l(0,0, 4,0);
     cursor.next.sym(4,8);
    };
  };
  lower { # task.new
   a {};
   b {};
   c {};
   d {};
