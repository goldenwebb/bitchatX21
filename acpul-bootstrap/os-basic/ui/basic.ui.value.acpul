psize(u0, 1);
#color(u0, 1, 1, 0, 0.7);
color(u0, 1, 0.3, 0.8, 0.7);
};

chars.color.white 1;
if (style == 1) {
 psize(u0, 1);
 color(u0, 1, 1, 1, 1);
};

mode p0;

# mode 0 : format 0.00 [

if (mode == 0) { 
 twobin.font.def8x4.print.v1(S.format.value0a, value0);
};

# mode 0 : format 0.00 ]
