twobin.font.def8x4.txt0 {
 begin;
 cy:=0;
};
twobin.font.def8x4.txt0;

twobin.font.scale h/8; #l3
twobin.font.cursor.x l0;
twobin.font.cursor.y l1;
#twobin.font.cursor.y l1+110*sin((cursor.x+t*100)*0.01);
#twobin.font.gap 10+5*rnd(u0);
#twobin.font.gap 10+5*sin(sin(t*10)+cursor.x);
twobin.font.gap 10;

t0 l10;
twobin.font.def8x4.print.buf0 t0;

style r2;

if (style == 0) {
# bg color
#color(u0, 0, 0.5, 0, 0.7);
#color(u0, 0, 0.5, 0.8, 0.7);
color(u0, 0.1, 0, 0.3, 0.2);
rect(u0, 2, 0,0,w,h);

# chars color
