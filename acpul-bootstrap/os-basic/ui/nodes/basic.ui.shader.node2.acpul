### 900778 basic.ui.shader.node2
# w,h, mode, filter
# [0] -> texutre

mode p2;
filter0:=p3;

_ @4;

r0:=k==0;

if ((w==0)+(h==0)) {
 w:=p0;
 h:=p1;
};

draw(r0, 900779);

tex0 r1;
filter0 r2;

if (r0) {
 create.texture {
  tex0:=node.ex.texture.create(u0, w,h);
  node.value.s(u0, nid,0, tex0);
 };
 create.texture;
};
 
#_ @basic.ui.shader.node2.inc;
#filter.self:=filter0;

#_ @4;
#ui.value1(l11,0,0,1, filter.self);
