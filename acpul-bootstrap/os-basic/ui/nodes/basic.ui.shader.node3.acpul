### 900784 basic.ui.shader.node3
# w,h, vsh,fsh
# 0: -> texutre
# 1: draw.off - disable draw: 0 - draw, 1 - no draw, 2 - no fbo

#y:=100;

_ @4;

if ((w==0)+(h==0)) {
 w:=p0;
 h:=p1;
#shader.set.uniform.v2(nid, iResolution, w,h);
};

vsh0 r2;
fsh0 r3;

vsh0:=p2;
fsh0:=p3;

draw(r0, 900785);

tex0 r1;

tw r5;
th r6;

if (r0) {
 create.texture {
  tw:=w;
  th:=h;

#  tex0:=node.ex.texture.create(u0, w,h);
  tex0:=node.ex.texture.create.fmt(r0, w,h, node.ex.texture.fmt.rgba8888, 1);
  node.value.s(u0, nid,0, tex0); # 0: tex
 };
 create.texture;
 node.value.s(u0, nid,1, 0); # 1: draw.off
};

#nid00:=rnd(u0);

_ @sys.obj.key;
_ @sys.shader.ex;

#obj_key_set_v(u0, 2, nid, A.value1, 0, 1);

#obj.key.set(u0, 2, nid, A.value1, 0, 1);
#obj.key.set2(u0, 2, nid, iResolution, 0, w,h);

_ @sys.display;

# hack! iResolution*2 [
sscale=display.scale(u0, 0);
sscale:=if(sscale==2,1,3/2); # MAGIC!
# hack! iResolution*2 ]

# scale to texture
sw tw/w;
sh th/h;

resolution.x w*sscale*sw;
resolution.y h*sscale*sh;

shader.set.uniform.v2(nid, iResolution, w*sscale*sw,h*sscale*sh);
#shader.set.uniform.v2(nid, iResolution, w*sscale,h*sscale);


#_ @4;

#ui.value1(l11,0,0,1, resolution.x);
#ui.value1(l12,0,100,1, resolution.y);
#ui.value1(l11,0,0,1/5, sscale);
