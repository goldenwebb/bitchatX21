### 900785 basic.ui.shader.node3.draw

_ @4;
_ @900776;
_ @1100;
_ @util.gl.std;

_ @sys.obj.key;
_ @sys.shader.ex;

#

tex0 r1;

vsh0 r2;
fsh0 r3;

draw.off r4;

rendered l1;

tw r5;
th r6;

#

is.texture draw.off!=2;

#

draw.to.fbo {
 node.ex.gl.fbo(u0, tex0);
 node.ex.gl.clear(u0, 0,0,0,0);

 gl.shader.use(vsh0,fsh0);

 #gl.shader.use(70014,28415);
 #obj.key.set(u0, 0, nid, time, 10124);
 #shader.load.uniforms(u0, nid);
 #gl.shader.use(70014,28766);
 shader.load.uniforms(u0, nid);

 gl.rect0(5, 0,0, tw,th);
# gl.rect0(5, 0,0, w,h);
 #gl.rect0(5, 0,0, 1000,1000);
 node.ex.gl.fbo(u0, -1);
};


if (draw.off==0) {
 rendered:=0;
};

if (rendered==0) {
 rendered:=1;
 draw.to.fbo;
};

# NO TEXTURE
if (is.texture==0) {
 gl.shader.use(vsh0,fsh0);

 shader.load.uniforms(u0, nid);

 gl.rect0(5, 0,0, w,h);
};

if (is.texture) {
 gl.rect0.texture(5, 0,0, w,h, tex0);
};

#rect(u0, 2, 0,0, w,h);


