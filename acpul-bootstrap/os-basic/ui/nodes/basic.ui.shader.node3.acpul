#ui.value1(l11,0,0,1, filter.self);
#ui.value1(l11,0,0,1, filter.params.count.g);

#ui.value1(l11,0,0,1, vsh0);
#ui.value1(l12,0,100,1, fsh0);

# DRAW OFF [

draw.off r4;
draw.off:=node.value.g(u0, nid,1);

# DRAW OFF ]
# EVENTS [

_ @sys.events;
_ @os.util2;

my.ev {
 # ev, o0... - event
 if (_0==ui.event.change.texture) {
  tex0:=o0;
