### 15300 os.monitor.view.v2
# type
type0 p0;
r0:=k==0;

draw(r0, 15301);

_ @1010;
_ @sys.obj;
_ @sys.node;
_ @sys.os;
_ @os.basic;
_ @os.graph0.inc;
_ @sys.cpu;
_ @os.monitor;

graph0 r7;
values0 r2;

count0 l8;

mon os.monitor.mon;


graph.view.new {
 count0:=1000;
 _ os.graph0;
 if (type0==mon.memory) {
  graph0:=node.new.this.ex8(r0, os.graph0.view, S.Memory, mode.line2d, style.default, values0,count0, 0);
 };
 if (type0==mon.battery) {
  graph0:=node.new.this.ex8(r0, os.graph0.view, S.Battery, mode.line2d, style.default, values0,count0, 0);
 };
 if (type0==mon.disk) {
  graph0:=node.new.this.ex8(r0, os.graph0.view, S.Disk, mode.line2d, style.default, values0,count0, 0);
 };
 if (type0==mon.total.nodes) {
  graph0:=node.new.this.ex8(r0, os.graph0.view, S.Nodes, mode.line2d, style.default, values0,count0, 0);
 };
 if (type0==mon.fps) {
  count0:=100;
  graph0:=node.new.this.ex8(r0, os.graph0.view, S.FPS, mode.line2d, style.default, values0,count0, 0);
 };
 values0:=node.value.g(u0, graph0,0);
};

if (r0) {
 graph.view.new;
 
 dma0 0;

 buffer.clear {
  buffer.dma(u0, dma0, values0,0);
  dma.fill(u0, dma0,0,count0, 0);
 };

# buffer.clear;
};

last.value buffer.get(u0, values0,0,0);

values.update {
 # values, (a,b)
 values0 _0;
 a _1;
 b _2;
 c _3;
 n:=count0;
 i:=0; while(i<n) {
  buffer.set(u0, values0,0,i, sin(t+i*a)*b+c*rnd(u0));
#  buffer.set(u0, values0,0,i, sin(t+i*a)*b+c*sin(t+i*a*)/2);
  i+=1;
 };
};
if (r0) {
#values.update(values0, 0.1, 100, 10);
#values.update(values0, 0.5+sin(t*5), 10, 10);
};

value.s
 # v
 buffer.set(u0, values0,0,count0-1, _0);

value.s1
 # n, v
 buffer.set(u0, values0,0,count0-1-_0, _1);

#value.s(rnd(u0));
#value.s(0-100*rnd(u0));
#value.s(0);


# hack [
value.minmax {
 # min,max
 buffer.set(u0, values0,0,0, _0);
 buffer.set(u0, values0,0,count0-1, _1);
};
# hack ]
t0 r3;
t0+=dt;

_ @4;

vkb0 l1;
vkb1 l2;
vkb2 l3;
vkb3 l4;

# up/down charge indicator (need update)
indicator0 r1;

# battery [

level.prev 0;
level.prev1 0;

if (type0==mon.battery) {
 battery;
 repeat 0;
 if (t0==0) {
  level.prev:=battery.level;
  level.prev1:=battery.level;
 };
 if ((t0>15)) {
  t0-=15;
  buffer.shr(u0, values0,0);

  repeat+=1;
  if (level.prev1!=battery.level) {
   level.prev:=level.prev1;
   level.prev1:=battery.level;
   repeat:=0;
  };
  if (level.prev1==battery.level) {
   if (repeat>=10) {
    level.prev1:=battery.level;
    level.prev:=battery.level;
   };
  };
 };
 ui.value0(vkb1, 7,60,0.15, 50,50, battery.level);

 v.min = min(last.value, v.min);
 v.max = max(battery.level, v.max);
 ui.value0(vkb0, 60,80,0.15, 50,50, v.max);
 ui.value0(vkb2, 7,10,0.15, 50,50, v.min);

# ui.value0(vkb3, w-30,50,0.15, 50,50, repeat);
# vkb4 0;
# ui.value0(vkb4, w-30,70,0.15, 50,50, level.prev);

 level = battery.level;
 indicator0 := if(level.prev == level, 0, if(level.prev < level, 1, -1));
};

# battery ]
# memory [

if (type0==mon.memory) {
 buffer.shr(u0, values0,0);
 memory;

 ui.value.kb0(vkb0, 60,80,0.15, 50,50, memory.used);
 ui.value.kb0(vkb1, 7,60,0.15, 50,50, memory.free);
 ui.value0(vkb3, 7,40,0.15, 50,50, memory.ratio1);
 vkb4 0;
 ui.value.kb0(vkb4, 60,10,0.15, 50,50, memory.total);
 ui.value.kb0(vkb2, 7,10,0.15, 50,50, last.value);
};

# memory ]
# disk [

if (type0==mon.disk) {
 buffer.shr(u0, values0,0);
 disk;

 ui.value.kb0(vkb0, 60,80,0.15, 50,50, disk.total);
 ui.value.kb0(vkb1, 7,60,0.15, 50,50, disk.free);
 ui.value.kb0(vkb2, 7,10,0.15, 50,50, last.value);
};

# disk ]
# total nodes [

if (type0==mon.total.nodes) {
 buffer.shr(u0, values0,0);
 n=cpu.get.nodes.count(u0);
#n:=111;
 value.s(n);

 if (t0>2) {
  t0-=2;
  v.min:=9999990;
  v.max:=0;
 };
 v.min = min(last.value, v.min);
 v.max = max(n, v.max);
 ui.value0(vkb0, 60,80,0.15, 50,50, v.max);
 ui.value0(vkb1, 7,10,0.15, 50,50, v.min);
 ui.value0(vkb2, 7,h/2,0.15, 50,50, n);
};

# total nodes ]
# fps [

if (type0==mon.fps) {
 buffer.shr(u0, values0,0);
 fps 1/dt;
 value.s(fps);
# value.s(dt);
# watch(fps);
 if (t0>2) {
  t0-=2;
  v.min:=9999990;
  v.max:=0;
 };
 v.min = min(last.value, v.min);
 v.max = max(fps, v.max);
 ui.value0(vkb0, 60,80,0.15, 50,50, v.max);
 ui.value0(vkb2, 7,10,0.15, 50,50, v.min);
};

# fps ]

# value.minmax(0, 100);

battery {
 l0:=cpu.get.battery.info(u0);
 max=100;
 level=o1*max;
# level:=1000;
# value.minmax(0, 1);
 value.s1(1,level);
 value.s1(0,max); 
};

disk {
 l0:=cpu.get.disk.info(u0);
 total=o0;
 free=o1;
 ratio free/total;
# value.s(ratio);
 value.s(total-free);
};

memory {
 l0:=cpu.get.memory.info(u0);
 total=o0;
 free=o1;
 used=o2;
 ratio=free/total;
 ratio1=used/total;
# ratio total;
# value.s(ratio);
 value.s(used);
# value.s(free);
# watch(free);
# watch(used);
# value.minmax(0, total);
};


if (r0) {
 w:=100;
 h:=100;
};

node.prop.w.s(u0, graph0,w);
node.prop.h.s(u0, graph0,h);

k:=1;

### 15301 os.monitor.view.v2.draw

color(u0, 0.5,0.5,0,0.5);
#rect(u0, 6, 0,0,w,h);
#psize(u0, 10);

indicator0 r1;
#indicator0=-1;
if (indicator0==1) {
 w0 15;
 h0 20;
 x0 w-w0-5;
 y0 25;
 x1 x0+w0/2;
 y1 y0+h0;
 x2 x0+w0;
 y2 y0;
 color(u0, 0,1,0,1);
 triangle(u0, 6, x0,y0, x1,y1, x2,y2);
};

if (indicator0==-1) {
 w0 15;
 h0 20;
 x0 w-w0-5;
 y0 25+h0;
 x1 x0+w0/2;
 y1 y0-h0;
 x2 x0+w0;
 y2 y0;
 color(u0, 1,0,0,1);
 triangle(u0, 6, x0,y0, x1,y1, x2,y2);
};

