 ev _0;
   watch(ev);

 if (ev==ev.ide.event.open.console) {
  node.visible.s(u0, 0);
 };
};

_ @sys.events;
ev0 d0;
ev0:=events.pop(u0, ide.pool,0);
#watch(ev0);
while(ev0) {
watch(ev0);
 process.events(ev0);
  
 ev0:=events.pop(u0, ide.pool, 0);
};
};


