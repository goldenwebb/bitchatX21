# BUTTON TIMER [

open.console.canceled 0;

timer0 0;

if (timer0>0) {
 timer0+=dt;
};

if (timer0>1) {
 timer0:=0;
 open.console.canceled:=1;
 
 # toggle visible
 visible0:=if(visible0,0,1);
 set.visible(visible0);
};

# BUTTON TIMER ]
# events [

ide.common 15510;
_ @ide.common;

_ @dota.fly.box1;

events.loop {
 # ev
 ev _0;

 if (ev==ui.event.button.push) {
  bid=o0;
  xid=node.value.g(u0, bid,1);
  if (xid==ev.open.console) {
   timer0:=0.001;
   open.console.canceled:=0;
  };
 };
 
 if (ev==ui.event.button.pop) {
  bid o0;
  xid node.value.g(u0, bid,1);
  timer0:=0;

  if (xid==ev.open.console) {
   if (open.console.canceled==0) {
    cpu.debug.console.on(u0, -1);
    events.push(u0, ide.pool,0, ev.ide.event.open.console, 0, 0,0,0);
   };
  };
  if (xid==ev.save) {
   cpu.formulas.save(u0, 0, 0);

   storage.save.all.formulas(storage.t.data,70000); # todo

   # Flybox
   x0 node.prop.x.g(u0,bn1);
   y0 node.prop.y.g(u0,bn1)/2;
   fly.box1(x0,y0,0.75, rnd(u0)*100);
  };
  if (xid==ev.reset) {
   cpu.reset(u0, 1000, 0);
   cpu.set.frame.time(u0, 0); # not works?
  };
 };
};

events.xprocess(nid, events.loop, r2);

#events.push(r0, ide.pool,0, ev.ide.event.open.console, 0, 0,0,0);

qqq {
process.events {
