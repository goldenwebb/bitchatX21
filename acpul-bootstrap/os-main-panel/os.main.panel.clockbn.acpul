### os.main.panel.clockbn

#_ @sys.os;
_ @os.monitor;
_ @os.util0;

memmon 0;
clockbn 0;
clockpatek 0;
sign1 0;
pyramid1 0;
lucky1 0;

#mode 4;
#mode.max 5;
mode 3;
mode.max 4;
mode.clockpatek 0;
mode.lucky 0;

if ((memmon==0)*(w!=0)) {
 os.monitor.new.memory(memmon, 0,0,1, w,h);
# os.monitor.new.memory(memmon, 0,0,1*rnd(u0), w,h);

 new.node.common0(clockbn, -3,-3,1, w+3+5,h+6, node.fid.by.name(u0, simple.clock), 0);
#w 100;
#h 100;
 
 PATEK.PHILIPPE=node.fid.by.name(u0, patek.philippe.clock);
 if (PATEK.PHILIPPE>0) {
  new.node.common0(clockpatek, -3,-3,1, w+3+5,h+6, PATEK.PHILIPPE, 0);
  mode.clockpatek:=mode.max;
  mode+=1;
  mode.max+=1;
 };

 LUCKY=node.fid.by.name(u0, os.main.panel.lucky.clover);
 if (LUCKY>0) {
  new.node.common0(lucky1, -3,-3,1, w+3+5,h+6, node.fid.by.name(u0, os.main.panel.lucky.clover), 0);
  mode.lucky:=mode.max;
  mode+=1;
  mode.max+=1;
 };

 new.node.common0(sign1, -3,-3,1, w+3+5,h+6, node.fid.by.name(u0, os.main.panel.sign1), 0);

 new.node.common0(pyramid1, -3,-3,1, w,h, node.fid.by.name(u0, os.main.panel.pyramid1), 0);

 # clockpatek disable if not prsent
# if (clockpatek==0) {
#  mode:=3;
#  mode.max:=4;
# };
};


# ## os.main.panel.clockbn111

TOUCH_NO_ANCHOR 0;
TOUCH_ANCHOR_X 0-w/2;
TOUCH_ANCHOR_Y 0-h/2;

_ @touch.tool.default;
l12;
x:=0+w/2;
y:=0+h/2;
l13;
if(pressed){
 s:=s-1*dt;
 s:=if(s>0.95,s,0.95);
};
if(pressed==0){
 s:=1;
};
l14;
node.anchor.point.s(r0, 0.5,0.5);
l15;
touch.click.ended {
if (clicked) {
# mode:=if((mode+1)==2,0,mode);
  mode-=1;
  mode:=if(mode<0,mode.max-1,mode);
 };
};
l16;
node.prop.visible.s(u0, memmon, mode==0);
node.prop.visible.s(u0, sign1, mode==1);
node.prop.visible.s(u0, pyramid1, mode==2);
node.prop.visible.s(u0, clockbn, mode==3);
node.prop.visible.s(clockpatek, clockpatek, mode==mode.clockpatek);
node.prop.visible.s(lucky1, lucky1, mode==mode.lucky);

### os.main.panel.sign1

_ @4;
_ @os.util0;

_ @basic.ui.shader.node3.inc;
_ @sys.shader.ex;

_ @basic.poly2d;
_ @basic.poly2d.test;
_ @basic.lines2d.test;

_ @hero.sign1;

sn2poly 0;
sn2sign 0;
sn1lines 0;

if ((sn2poly==0)*(w!=0)) {
 new.poly2d(sn2poly, 0,0,1, w,h);
 lines2d.figure2(sn2poly);

 hero.sign.create(sn2sign, 0,5,1, w,h);
 #hero.sign.color.purple1(sn2sign);
 #hero.sign.color.purple2(sn2sign);
 #hero.sign.color.purple3(sn2sign);
 #hero.sign.color.orange1(sn2sign);
 hero.sign.color.rgb1(sn2sign);
 #hero.sign.color.purple4(sn2sign);
 #hero.sign.color.green1(sn2sign);

 new.lines2d(sn1lines, 0,0,1, w,h);
 lines2d.figure2(sn1lines);
 lines2d.figure3.color1(sn1lines);
 shader.set.uniform.v4(sn1lines, A.backgroundColorAdd, -0.5, -0.5, -0.5, 0);
};

### os.main.panel.pyramid1

_ @4;
_ @basic.ui.shader.node3.inc;
_ @sys.shader.ex;

sn0 0;

if ((sn0==0)*w*h) {
 new.ui.shader.node3(sn0, 0,0,1, w,h, 70014,28937); # dota.magic.pyramid
};

### os.main.panel.lucky.clover

_ @4;
_ @basic.ui.shader.node3.inc;
_ @sys.shader.ex;

sn0 0;

# VISIBLE [

visible=node.prop.visible.g(u0, nid);
if (visible==0) {
 node.set.lt(u0, sn0, 0.01);
 sn0:=0;
};

# VISIBLE ]
# Q [

# calc q always
q=rnd(u0);

# Q ]
# NEW [

if ((sn0==0)*w*h*(visible)) {
# q=0.8;
 a q<0.3;
 b 0+(q>=0.3)*(q<0.7);
 c q>=0.7;

 if (a) {
  new.ui.shader.node3(sn0, 0,0,1, w,h, 70014,29418); # lucky.clover
 };
 if (b) {
  new.ui.shader.node3(sn0, 0,0,1, w,h, 70014,29419); # sphere.ufo
 };
 if (c) {
  new.ui.shader.node3(sn0, 0,0,1, w,h, 70014,29242); # patrick2025.clever
 };
};

# NEW ]
