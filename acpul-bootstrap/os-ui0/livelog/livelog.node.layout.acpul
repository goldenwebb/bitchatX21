# layout.process;

# LAYOUT [

align0 TOP;
#align0 BOTTOM;

align0 layout.options.align;


parent0=node.get.parent(u0, nid0);

layout.types.experimetal {
 rock;
 water;
 wind;
};


margin0 layout.options.margin;


#margin0.x 40;
#margin0.y 40;

#LINK.TO.PARENT 1;
#LINK.TO.PARENT layout.options.type == layout.options.align.type.by.parent;
LINK.TO.PREV 1;
#LINK.TO.PREV layout.options.type == layout.options.align.type.by.prev;

tree.layout {
 parent.w node.prop.w.g(u0, parent0);
 parent.h node.prop.h.g(u0, parent0);

 update.size.width {
  w:=parent.w;
 };

 update.position.by.prev.vertical {
  y:=0;
  index0=node.get.index(u0, nid0);

# BAD CASE - becase parent.h = bbox(child) <--- this child  
#  # CASE A: link to parent
#
#  if (LINK.TO.PARENT) {
#   if (align0==RIGHT) {
#    x:=-margin0.x;
#    y:=margin0.y;
#   };
#   if (align0==LEFT) {
#    x:=margin0.x + parent.w;
#    y:=margin0.y;
#   };
#   if (align0==TOP) {
#    x:=margin0.x;
#    y:=margin0.y + parent.h*0.07;
#   };
#   if (align0==BOTTOM) {
#    x:=margin0.x;
#    y:=-margin0.y;
#   };
#  };

  # CASE B: link to prev

  if (LINK.TO.PREV) {

   # FIRST CHILD: aligned to parent

   if (index0==0) {
     x:=-margin0.x;
     y:=margin0.y;
    if (align0==RIGHT) {
     x:=-margin0.x;
     y:=margin0.y;
    };
    if (align0==LEFT) {
     x:=margin0.x;
     y:=margin0.y;
    };
    if (align0==TOP) {
     x:=margin0.x;
     y:=margin0.y;
    };
    if (align0==BOTTOM) {
     x:=margin0.x;
     y:=-margin0.y;
    };
   };

   # NEXT CHILD: aligned to prev

   if (index0>0) {
    prev0=node.get.child.at(u0, parent0,index0-1);

    prev0.y node.prop.y.g(u0, prev0);
    prev0.x node.prop.x.g(u0, prev0);
    prev0.h node.prop.h.g(u0, prev0)*node.prop.s.g(u0, prev0);
    prev0.w node.prop.w.g(u0, prev0)*node.prop.s.g(u0, prev0);

    if (align0==RIGHT) {
     x:=prev0.x - margin0.x;
     y:=prev0.y+margin0.y;
    };
    if (align0==LEFT) {
     x:=prev0.x+prev0.w + margin0.x;
     y:=prev0.y+margin0.y;
    };
    if (align0==TOP) {
     x:=margin0.x;
     y:=prev0.y+prev0.h + margin0.y;
    };
    if (align0==BOTTOM) {
     x:=margin0.x;
     y:=prev0.y - margin0.y;
    };
   };
  };
 };

 update.wh.bbox {
  node.get.bounding.box(u0, -1, 0);
  #x:=o0;
  #y:=o1;
#  w:=min(o2, w.min);
#  h:=min(o3, h.min);
  w:=o2;
  h:=o3;
 };
 
 vertical.mode {
  update.position.by.prev.vertical;
  update.size.width;
#  update.wh.bbox(100,100);#(w,h);
 };
};

layout.updated 0;

layout.process {
#tree.layout.vertical.mode;
#if ((t<2)+layout.updated) {
#layout.updated:=0;
tree.layout.update.position.by.prev.vertical;

tree.layout.update.wh.bbox;
#};
#x:=depth*20;
};

# LAYOUT ]

