### livelog.node.layout.options

_ @struct.def;

layout.options { _ struct;

 margin.x 0;
 margin.y 0;

 align.type { # link
#  by.parent 0;
  by.prev 1;
 };

 type 0; # link

 align 0;
# align RIGHT;
# align TOP;
# align BOTTOM;
 
 new {
  buf0:=0;
  margin.x:=_0;
  margin.y:=_1;
  type:=_2;
  align:=_3;
 };

 pack pack4(margin.x, margin.y, type, align);
 unpack {l5;unpack4(_0, margin.x, margin.y, type, align);};

 test {
  layout.options.new(20,20, align.type.by.prev, TOP);
  layout0 = layout.options.pack;
  layout.options.unpack(layout0);
 };
};

