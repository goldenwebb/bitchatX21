### ui0.scroll.inc

new.scroll {
 # x,y,s, w,h, mode -> hid
 _ @basic.ui;
 hid0 0;
 new.node.common0(hid0, _0,_1,_2, _3,_4, NNN(ui0.scroll), _5);
 hid0;
};

scroll.add {
 # scroll, node
 scroll0 _0;
 node0 _1;
 if (scroll0) {
  content0=node.value.g(u0, _0,0);
  node.change.parent(u0, content0, node0);
  node.set.v(node0, VIEW.OWNER, scroll0);
 };
};

### ui0.scroll
# 0: scroll content

_ @help.inc1;

draw.fid(ui0.scroll.draw);

content0 0;

if (r0) {
 new.node.common0(content0, 0,0,1, 100,100, NNN(ui0.scroll.content), 0);
 node.value.s(u0, nid,0, content0);
};

cx0=node.value.g(u0, content0,0);
cy0=node.value.g(u0, content0,1);
cw0=node.value.g(u0, content0,2);
ch0=node.value.g(u0, content0,3);

ox0 0;
oy0 0;

node.set.x(u0, content0, ox0-cx0);
node.set.y(u0, content0, oy0-cy0);

#lbl0 0; val0 0; ui.value4(lbl0,val0,0,0,1, S.scroll, nid);

# TOUCH [

_ @sys.touch;

#visible 1;

pressed 0;
clicked 0;

touch.ev {
 x0 0;
 y0 0;

 began {
  # x,y, gx,gy

  x0:=_2;
  y0:=_3;
#  xs:=x0;
#  ys:=y0;

  pressed:=1;
  clicked:=1;
 };
 moved {
  # x,y, gx,gy

  ox0+=_2-x0;
  x0:=_2;
  oy0+=_3-y0;
  y0:=_3;

#  xp = x0;
#  yp = y0;

  # check clicked
