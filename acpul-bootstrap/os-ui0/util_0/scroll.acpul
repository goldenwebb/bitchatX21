cx0 0;
cy0 0;
cw0 0;
ch0 0;

update.bbox {
 node.get.bounding.box(u0, -2, 0); # -2 children only
 cx0:=o0;
 cy0:=o1;
 cw0:=o2;
 ch0:=o3;
};
update.bbox;

info {
 lbl0 0; val0 0; ui.value4.nobbox(lbl0,val0,0,0,1, CX, cx0);
 lbl0 0; val0 0; ui.value4.nobbox(lbl0,val0,0,20,1, CY, cy0);
 lbl0 0; val0 0; ui.value4.nobbox(lbl0,val0,0,40,1, CW, cw0);
