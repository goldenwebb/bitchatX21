};

#touch.owner 
# node.get.s(nid, TOUCH.OWNER, touch.owner);

create.entry {
 # entry
 entry0 _0;
 entry1 0;
 new.node.common0(entry1, 0,0,1, 100,100, NNN(texture.selector.entry), entry0);
 entry1;
};

xstack.add.div0.ex0 {
 # stack, view, div:w:h, touch:owner
 stack0 _0;
 touch.owner _4;
 xstack.add.div0(__);
 node.get.s(stack0, TOUCH.OWNER, touch.owner);
};

xstack.add.entry0 {
 # hstack0, entry0
  hstack0 _0;
  entry0 _1;
  entry1=create.entry(entry0);

  xstack.add.div0(hstack0, entry1, 100,100);
  node.set.v(entry1, TOUCH.OWNER, vstack0);

#  xstack.add.div0.ex0(hstack0, entry1, 100,100, hstack0);
};

xstack.add.entry1 {
 # hstack0, entry0, col,max
 hstack0 _0;
 entry0 _1;
