  hstack0:=xstack.add.hstack(vstack0, 0,0,1, 100,100, 1);
  col:=0;
 };

 xstack.add.entry0(hstack0, entry0);
 col+=1;
};

add.entries {
 # entries,i, col,max
 entries0 _0;
 i0 _1;
 col _2;
 max _3;

 n=buffer.size(u0, entries0,0);
 #lbl0 0; val0 0; ui.value4(lbl0,val0,0,160,1, N, n);
# col=0; 
# max=5;
 i=0; while(i<n) {
  entry0=buffer.get(u0, entries0,i0,i);
  xstack.add.entry1(hstack0, entry0, col, max);

