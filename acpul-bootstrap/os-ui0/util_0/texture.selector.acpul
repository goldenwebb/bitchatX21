  events.push(u0, ui.pool,nid, ev.select.texture, tex0,0, 0,0);
  events.push(u0, ui.pool,0, ev.select.texture, tex0,0, 0,0);
 };
};

ui.event.process4(ui.pool,vstack0, entry.ev);

# PROCESS EVENTS ENTRIES ]
# PROCESS EVENTS CPU TEXTURE [

