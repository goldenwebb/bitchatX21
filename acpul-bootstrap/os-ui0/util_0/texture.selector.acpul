# PROCESS EVENTS ENTRIES [

_ @sys.events;

entry.ev {
 # ev, o0... - event
 if (_0==ui.event.touch.click) {
  # nid,0, x0,y0
  nid1=o0;
  tex0=node.value.g(u0, nid1,0);
#  node.prop.lt.s(u0, nid1, 0.1);
