### texture.selector.entry
# tex

tex0 p0;

_ @help.inc1;
_ @easy.start.new1;
_ @sys.cpu;

_ @ui.value5.up;

sn0 0;
preview0 0;

if ((sn0==0)*w*h) {
# new.ui.shader.node3(sn0, 0,0,1, w,h, 70014,28542); # crystal

 # disable events to prevent recursive
 cpu.set.texture.event.enable(u0, 0);

# new.ui.shader.node3(preview0, 0,0,0.1, w,h, 70014,28890); # mix.in2.alpha
 new.ui.shader.node3(preview0, 0,0,1, w,h, 70014,28890); # mix.in2.alpha
 shader.set.texture(preview0, A.iChannel0, tex0);
 shader.set.uniform.v(preview0, A.mode, 4);
 sn0:=preview0;

 cpu.set.texture.event.enable(u0, 1);

 node.value.s(u0, nid,0, tex0);
};

draw.fid(texture.selector.entry.draw);

create.info {
 node.transform.point(u0, ui.dbg.layer, nid, 0,0);
 val0 0;ui.value5.start(val0, o0+w,o1+h,1, 200,200, nid);
 ui.value5.v(A.tex0, tex0);
 flip.x=0;
 flip.y=0;
 ui.value5.v(A.flip.x, flip.x);
 ui.value5.v(A.flip.y, flip.y);
 tw=node.texture.width(tex0);
 th=node.texture.height(tex0);
 ui.value5.v(A.tex.w, tw);
 ui.value5.v(A.tex.h, th);
 ratio=tw/th;
 ui.value5.v(A.ratio, ratio);
# ui.value5.graph(A.x1, x1);
#  ui.value5.graph(A.y1, y1);
#
#  ui.value5.graph(A.dx0, dx0);
#  ui.value5.graph(A.dy0, dy0);
};
# info;

# TOUCH [

_ @sys.touch;

visible 1;

pressed 0;
clicked 0;

touch.ev {
 x0 0; y0 0;
 xs 0; ys 0; 
 dy.max 5;
 
 event0 {
#  parent0=node.get.parent(u0, nid);
#  owner=node.get.v(parent0, TOUCH.OWNER);
  owner=node.get.v(nid, TOUCH.OWNER);
  events.push(u0, ui.pool,owner, _0, _1,_2, _3,_4);
 };

 # ui.event.touch.began(nid,0, gx,gy)
 # ui.event.touch.moved(nid,0, dx,dy)

 began {
  # x,y, gx,gy

  x0:=_2; y0:=_3;
  xs:=x0; ys:=y0;

  pressed:=1;
  clicked:=1;
#  lt:=0.1;

#lbl0 0; val0 0; ui.value4(lbl0,val0,0,0,1, T.O, node.get.v(nid, TOUCH.OWNER));

  event0(ui.event.touch.began, nid,0, x0,y0);
 };

 moved {
  # x,y, dx,dy
  event0(ui.event.touch.move, nid,0, _2-x0,_3-y0);

  x0:=_2;
  y0:=_3;
#clicked:=0;
  # check clicked
  if (abs(y0-ys)>dy.max) {
   clicked:=0;
  };
 };

 ended {
  # x,y, gx,gy
  pressed:=0;

  event0(ui.event.touch.end, nid,0, _2-x0,_3-y0);

  if (clicked) {
   event0(ui.event.touch.click, nid,0, _2-x0,_3-y0);
   create.info;
  };
 };
};

if ((visible==1)+(pressed==1)) {
 touch1.rect3(0,0,w,h, touch.ev);
};

touch1.rect3 {
 # x,y,w,h, handler
 touch.id 0;
 touch.b0 0;
 x _0; y _1; w _2; h _3;

 touch.rect2.lock(touch.id, x,y,w,h);

 touch.ev _4;

 _ @sys.touch.ev.process.once;
 touch.b0:=1;
 touch.ev.process.multi;
};

# TOUCH ]

_ @4;
#lbl0 0; val0 0; ui.value4(lbl0,val0,0,0,1, TEX, tex0);

### texture.selector.entry.draw

#color(u0, 0,0,1,1);
rect(u0, 2,0,0,w,h);
