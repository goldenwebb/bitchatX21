llog.b(Hackernews.node);

reload 0;

lname0 0;

if (r0) {

 lname0 := livelog2.get.name(u0, livelog0,lnode0, lname0);
 
# llog.b(A.Hackernews.node);
#    llog.po(A.name, 0+8, id,-1);
#
# llog.e;

 reload := 1;
};

sync {
 reload := 0;

 id lname0;
 hn.req.topic(id);
};

#reqs0 0;

# LLOG2 UTIL [

llog2.set.attribute.v.add {
 # u0, lid, path|node, attr -> v
 v = llog2.get.attribute.v(_0, _1,_2, _3);
 v += _4;
 llog2.set.attribute.v(_0, _1,_2, _3, v);
};

llog2.set.attribute.v.sub
 # u0, lid, path|node, attr -> v
 add(_0, _1,_2, _3, -_4);

# LLOG2 UTIL ]

if (reload) {
 max.requests = llog2.get.attribute.v(u0, livelog0,OPTIONS.MaxRequests, Count);
 requests.count = llog2.get.attribute.v(u0, livelog0,OPTIONS.Requests, Count);
 if (requests.count < max.requests) {
  sync;

  requests.count += 1;
  llog2.set.attribute.v(u0, livelog0,OPTIONS.Requests, Count, requests.count);
 };
# llog.pv(A.max.requests, max.requests);
# llog.pv(A.requests.count, max.requests);
};

